# Copy to .env.local for local development. Set the same names in Vercel (Project → Settings → Environment Variables).
# Never commit real values.

# Public origin used for canonical URLs, sitemap and Open Graph (TBD until the domain exists).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enquiry delivery (src/app/api/enquiry/route.ts). With neither Resend nor the Sheets webhook set,
# the route answers 503 { ok: false, reason: "not-configured" } and the form says so honestly.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
SHEETS_WEBHOOK_URL=

# Optional rate limiting. Without these an in-memory best-effort limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Maps satellite view in the location section (src/components/map). Optional: without a key the section shows
# a static, themed fallback (address, coordinates and map links), so the page never shows a broken map.
# The key is public (it ships in the browser), so restrict it in Google Cloud: API restriction "Maps JavaScript API"
# only, and HTTP referrers https://parshwanathinfra.vercel.app/* and http://localhost:*. Set it in Vercel too.
# The API loads only when the section nears the viewport. Needs a rebuild to change (NEXT_PUBLIC_ values are inlined).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID (Google Cloud Console → Google Maps Platform → Map Management). Advanced Markers need one; without
# it Google's DEMO_MAP_ID is used.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
